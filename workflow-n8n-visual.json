      "id": "serper-1",
      "name": "Buscar en Serper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "jsCode": "const serperData = $input.item.json;\nconst leadInfo = $('Split In Batches').item.json;\n\nlet url_instagram = null;\nlet url_facebook = null;\nlet info_rrss_text = '';\n\n(serperData.organic || []).forEach(res => {\n   info_rrss_text += `[${res.title}] ${res.snippet}\\n\\n`;\n   const lcUrl = res.link.toLowerCase();\n   if (lcUrl.includes('instagram.com') && !url_instagram) url_instagram = res.link;\n   if ((lcUrl.includes('facebook.com') || lcUrl.includes('fb.com')) && !url_facebook) url_facebook = res.link;\n});\n\nleadInfo.url_instagram = url_instagram;\nleadInfo.url_facebook = url_facebook;\nleadInfo.servicios_detectados = info_rrss_text;\nleadInfo.estado_contacto = 'Pendiente Análisis IA';\n\nreturn { json: leadInfo };"
      },
