          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-API-KEY", "value": "4e6865059bd96ab759aff3cc5c151b10e0ab6966" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"q\": \"{{ $('Split In Batches').item.json.nombre_salon }} {{ $('Split In Batches').item.json.ubicacion }}\",\n  \"gl\": \"pe\",\n  \"hl\": \"es\",\n  \"num\": 5\n}",
