    {
      "parameters": {
        "method": "POST",
        "url": "https://places.googleapis.com/v1/places:searchText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-Goog-Api-Key", "value": "AIzaSyB7M7AtB5rJ4uNoIKo356_1bPeaP-8iAl8" },
            { "name": "X-Goog-FieldMask", "value": "places.displayName,places.formattedAddress,places.nationalPhoneNumber,places.rating,places.userRatingCount,places.businessStatus,places.primaryType,places.websiteUri" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"textQuery\": \"{{ $json.body.palabrasClaves.split(',')[0] }} en {{ $json.body.ubicacion }}\",\n  \"languageCode\": \"es\",\n  \"locationBias\": {\n    \"circle\": {\n      \"center\": {\n        \"latitude\": {{ $json.body.lat }},\n        \"longitude\": {{ $json.body.lng }}\n      },\n      \"radius\": {{ $json.body.radius }}\n    }\n  }\n}",
        "options": {}
      },
      "id": "google-places-1",
      "name": "Google Places",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "const places = $input.item.json.places || [];\nconst webhookData = $('Webhook CRM').first().json.body;\nconst pureKeywordsRaw = webhookData.pureKeywords || '';\nconst limit = parseInt(webhookData.limit) || 15;\nconst ubicacion = webhookData.ubicacion || '';\n\nfunction normalizeStr(str) {\n  return (str || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\n}\nconst strictKeywords = pureKeywordsRaw.split(',').map(t => normalizeStr(t.trim())).filter(t => t.length > 0);\n\nlet validLeads = [];\nfor (const place of places) {\n  if (validLeads.length >= limit) break;\n  if (!place.nationalPhoneNumber) continue;\n  \n  const name = normalizeStr(place.displayName?.text);\n  const primaryType = normalizeStr(place.primaryType);\n  \n  let isValid = false;\n  for (const term of strictKeywords) {\n    if (name.includes(term) || primaryType.includes(term)) { isValid = true; break; }\n  }\n  if (!isValid) continue;\n  \n  let telefono = place.nationalPhoneNumber.replace(/\\s/g, '');\n  let cleanPhone = telefono.replace(/\\D/g, '');\n  if (cleanPhone.length === 9 && cleanPhone.startsWith('9')) cleanPhone = '51' + cleanPhone;\n  \n  validLeads.push({\n    nombre_salon: place.displayName?.text || 'Desconocido',\n    direccion: place.formattedAddress || 'Sin dirección',\n    telefono: telefono,\n    cleanPhone: cleanPhone,\n    calificacion: place.rating || 0,\n    total_resenas: place.userRatingCount || 0,\n    sitioweb: place.websiteUri || null,\n    ubicacion: ubicacion\n  });\n}\n\nreturn validLeads.map(lead => ({ json: lead }));"
      },
      "id": "filter-1",
      "name": "Filtrar y Limpiar",
