{
  "name": "KoratFlow — Detector de Ghosting",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 10 * * 1-6"
            }
          ]
        }
      },
      "id": "cron-ghosting",
      "name": "Cron — Diario 10 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 300],
      "notesInFlow": true,
      "notes": "Corre una vez al día a las 10 AM, de Lunes a Sábado. Sábado incluido para limpiar los enviados del viernes."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://hywlytsbogbassecflbw.supabase.co/rest/v1/leads_salones",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "Bearer {{ $env.SUPABASE_ANON_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "automation_status", "value": "eq.sent" },
            { "name": "respondido_at", "value": "is.null" },
            { "name": "enviado_at", "value": "lt.{{ $now.minus({ hours: 24 }).toISO() }}" },
            { "name": "select", "value": "id,nombre_salon,telefono,enviado_at,estado_contacto" }
          ]
        },
        "options": {}
      },
      "id": "fetch-ghosts",
      "name": "Buscar Fantasmas (sent + sin respuesta 24h)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.id }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "if-has-ghosts",
      "name": "¿Hay Fantasmas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-ghosts",
      "name": "Split Fantasmas",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 2,
      "position": [600, 200]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://hywlytsbogbassecflbw.supabase.co/rest/v1/leads_salones?id=eq.{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "Bearer {{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"automation_status\": \"ghosted\",\n  \"estado_contacto\": \"Ghosting — Sin Respuesta\"\n}",
        "options": {}
      },
      "id": "mark-ghost",
      "name": "Marcar como Ghosting",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [800, 200]
    }
  ],
  "connections": {
    "Cron — Diario 10 AM": {
      "main": [[{ "node": "Buscar Fantasmas (sent + sin respuesta 24h)", "type": "main", "index": 0 }]]
    },
    "Buscar Fantasmas (sent + sin respuesta 24h)": {
      "main": [[{ "node": "¿Hay Fantasmas?", "type": "main", "index": 0 }]]
    },
    "¿Hay Fantasmas?": {
      "main": [
        [{ "node": "Split Fantasmas", "type": "main", "index": 0 }],
        []
      ]
    },
    "Split Fantasmas": {
      "main": [[{ "node": "Marcar como Ghosting", "type": "main", "index": 0 }]]
    },
    "Marcar como Ghosting": {
      "main": [[{ "node": "Split Fantasmas", "type": "main", "index": 0 }]]
    }
  },
  "_meta": {
    "description": "Runs daily at 10 AM. Finds all leads with automation_status='sent' AND respondido_at IS NULL AND enviado_at < 24h ago. Marks them as 'ghosted' to keep the Response Radar clean.",
    "schedule": "Once per day at 10 AM, Monday to Saturday.",
    "ghostingRule": "24 hours without reply after message was sent = Ghosting."
  }
}
